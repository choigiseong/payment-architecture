<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coco.payment.persistence.repository.CompanyRepository">
    <sql id="companyColumns">
        r.id AS id,
        r.company_name AS companyName,
        r.created_at AS createdAt,
        r.updated_at AS updatedAt
    </sql>

    <insert id="insert" parameterType="com.coco.payment.persistence.model.Company"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO company (company_name)
        VALUES (#{companyName})
    </insert>

    <select id="findById" resultType="company">
        SELECT <include refid="companyColumns" />
        FROM company AS r
        WHERE r.id = #{id}
    </select>
</mapper>
