<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coco.payment.persistence.mapper.OrderMapper">
    <sql id="orderColumns">
        r.id AS id,
        r.company_seq AS companySeq,
        r.total_price AS totalPrice,
        r.created_at AS createdAt,
        r.updated_at AS updatedAt
    </sql>

    <insert id="insert" parameterType="com.coco.payment.persistence.model.Order"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO "order" (company_seq, total_price)
        VALUES (#{companySeq}, #{totalPrice})
    </insert>

    <select id="findById" resultType="order">
        SELECT <include refid="orderColumns" />
        FROM "order" AS r
        WHERE r.id = #{id}
    </select>
</mapper>
